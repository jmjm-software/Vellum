# syntax=docker/dockerfile:1.7
#
# Vellum native widget renderer (sidecar).
#
# Renders the real Glance widget (its RemoteViews) to PNGs so the dashboard's
# preview worker can attach native widget screenshots to a review. It needs a
# JDK + Android SDK, which the main service image deliberately does not carry.
#
# Build:
#   docker build -f Containerfile.widget-renderer -t ghcr.io/<org>/vellum-widget-renderer:local .
#
# Run (sidecar for the dashboard service):
#   docker run -p 8790:8790 ghcr.io/<org>/vellum-widget-renderer:local
#   # then point the preview worker at it:
#   #   VELLUM_WIDGET_RENDERER_URL=http://widget-renderer:8790
#
# Endpoints:
#   GET  /health  -> { ok, renderer, running, queued }
#   POST /render  { spec } -> { files: [{ name, base64 }] }

# ---------------------------------------------------------------------------
# Stage 1: Android toolchain + warmed Gradle caches (also validates the image:
# the widget renderer is exercised once during the build)
# ---------------------------------------------------------------------------
FROM node:22-bookworm AS toolchain

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_HOME=/opt/android-sdk \
    GRADLE_USER_HOME=/opt/gradle-home \
    ANDROID_USER_HOME=/opt/android-user-home \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Android SDK: cmdline-tools + the platform/build-tools the app compiles against.
RUN mkdir -p "$ANDROID_HOME/cmdline-tools" \
    && cd /tmp \
    && curl -fsSL -o cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
    && unzip -q cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
    && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
    && rm cmdline-tools.zip \
    && yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$ANDROID_HOME" --licenses > /dev/null \
    && "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$ANDROID_HOME" \
         "platform-tools" "platforms;android-35" "build-tools;35.0.0" > /dev/null \
    && rm -rf "$ANDROID_HOME/.temp"

WORKDIR /renderer
# Only what the renderer needs: the Android module + the render scripts.
COPY android ./android
COPY scripts/render-widget-previews.sh scripts/widget-renderer-server.mjs ./scripts/
RUN chmod +x scripts/render-widget-previews.sh

# Warm the Gradle distribution + dependency caches and prove the renderer works
# (uses the renderer's built-in fixture; fails the build if the widget cannot be
# rendered). The resulting build directory is kept: incremental renders after
# this are considerably faster.
RUN cd android \
    && ./gradlew --no-daemon --console=plain :app:testDebugUnitTest \
         --tests "*WidgetPreviewRendererTest*" -Dvellum.outDir=/tmp/warmup \
    && ls -l /tmp/warmup \
    && test -s /tmp/warmup/widget-small.png \
    && rm -rf /tmp/warmup

# ---------------------------------------------------------------------------
# Stage 2: runtime
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_HOME=/opt/android-sdk \
    GRADLE_USER_HOME=/opt/gradle-home \
    ANDROID_USER_HOME=/opt/android-user-home \
    NODE_ENV=production \
    PORT=8790

# Gradle needs a full JDK (it compiles the android module's test sources).
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /renderer
COPY --from=toolchain /opt/android-sdk /opt/android-sdk
COPY --from=toolchain /opt/gradle-home /opt/gradle-home
COPY --from=toolchain /renderer/android ./android
COPY --from=toolchain /renderer/scripts ./scripts

# The renderer writes Gradle build output inside the module; keep it writable.
RUN chmod +x scripts/render-widget-previews.sh

EXPOSE 8790
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8790)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "scripts/widget-renderer-server.mjs"]
